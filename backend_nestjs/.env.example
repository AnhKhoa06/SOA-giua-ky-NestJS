# Sao chép file này thành ".env" rồi điền giá trị của máy bạn.
# KHÔNG commit file .env

# Kết nối MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=quanly_dotot_nghiep

# Tài khoản quản trị (đăng nhập hệ thống)
ADMIN_USER=
ADMIN_PASS=

# Khóa ký JWT: dùng 2 chuỗi ngẫu nhiên, dài, KHÁC NHAU
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Thời hạn token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

SINHVIEN_URL=http://localhost:3000/sinh-vien
DETAI_URL=http://localhost:3000/de-tai